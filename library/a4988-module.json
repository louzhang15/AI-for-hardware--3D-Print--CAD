{
  "id": "a4988-module",
  "name": "A4988 stepper driver carrier (Pololu-style)",
  "category": "driver",
  "description": "Bipolar stepper driver, 8-35 V motor supply, about 1 A per coil without heatsink (2 A max with cooling), up to 1/16 microstepping.",
