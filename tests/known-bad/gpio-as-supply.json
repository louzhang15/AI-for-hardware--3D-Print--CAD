{
  "meta": {
    "name": "Logic output tied to the servo power pin",
    "description": "Deliberately incorrect checker fixture. Never use as a build guide."
  },
  "parts": [
    {
      "id": "esp",
      "library": "esp32-devkit-v1"
    },
    {
      "id": "servo",
      "library": "servo-mg996r"
    },
    {
      "id": "supply",
      "library": "dc-adapter-5v-3a"
    }
  ],
  "wires": [
    {
      "id": "w1",
      "from": "supply.V+",
      "to": "esp.VIN"
    },
    {
      "id": "w2",
      "from": "supply.GND",
      "to": "esp.GND"
    },
    {
      "id": "w3",
      "from": "esp.GPIO25",
      "to": "servo.V+"
    },
    {
      "id": "w4",
      "from": "esp.GND",
      "to": "servo.GND"
    }
  ],
  "expect": [
    {
      "rule": "signal-as-power",
      "level": "error",
      "pins": [
        "esp.GPIO25",
        "servo.V+"
      ]
    }
  ]
}
