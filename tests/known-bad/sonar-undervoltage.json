{
  "meta": {
    "name": "Ultrasonic module powered from 3.3 V",
    "description": "Deliberately incorrect checker fixture. Never use as a build guide."
  },
  "parts": [
    {
      "id": "supply",
      "library": "dc-adapter-5v-3a"
    },
    {
      "id": "esp",
      "library": "esp32-devkit-v1"
    },
    {
      "id": "sonar",
      "library": "hc-sr04"
    }
  ],
  "wires": [
    {
      "id": "w1",
      "from": "supply.V+",
      "to": "esp.VIN"
    },
    {
      "id": "w2",
      "from": "supply.GND",
      "to": "esp.GND"
    },
    {
      "id": "w3",
      "from": "esp.3V3",
      "to": "sonar.VCC"
    },
    {
      "id": "w4",
      "from": "esp.GND",
      "to": "sonar.GND"
    }
  ],
  "expect": [
    {
      "rule": "under-voltage",
      "level": "warning",
      "pins": [
        "sonar.VCC"
      ]
    }
  ]
}
