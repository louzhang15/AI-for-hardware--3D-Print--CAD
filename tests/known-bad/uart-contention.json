    {
      "id": "w3",
      "from": "supply.GND",
      "to": "a.GND"
    },
    {
      "id": "w4",
      "from": "supply.GND",
      "to": "b.GND"
    },
    {
      "id": "w5",
      "from": "a.GPIO1",
      "to": "b.GPIO1"
    }
  ],
  "expect": [
    {
      "rule": "outputs-fight",
      "level": "error",
      "pins": [
        "a.GPIO1",
        "b.GPIO1"
      ]
    }
  ]
}
