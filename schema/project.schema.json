{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremap.local/schema/project.schema.json",
  "title": "Wiremap project",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "define",
            "parts",
            "power",
            "wire",
            "firmware",
            "print",
            "assemble",
            "test",
            "complete"
          ]
        },
        "requirements": {
          "type": "object"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": "string"
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^.]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "controller",
              "driver",
              "actuator",
              "sensor",
              "power",
              "battery",
              "protection",
              "passive",
              "module"
            ]
          },
          "description": {
            "type": "string"
          },
          "datasheet": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "verified",
              "checked",
              "confirm"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "internal": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            }
          },
          "regulators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "in",
                "out",
                "type"
              ],
              "properties": {
                "in": {
                  "type": "string"
                },
                "out": {
                  "type": "string"
                },
                "gnd": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "linear",
                    "buck",
                    "boost"
                  ]
                },
                "vout": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                    }
                  ]
                },
                "dropout": {
                  "type": "number"
                },
                "current_max": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                    }
                  ]
                },
                "iq": {
                  "type": "number"
                },
                "efficiency": {
                  "type": "number"
                },
                "vin_max": {
                  "type": "number"
                }
              }
            }
          },
          "battery": {
            "type": "object",
            "properties": {
              "chemistry": {
                "type": "string"
              },
              "cells": {
                "type": "integer"
              },
              "capacity_ah": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                  }
                ]
              },
              "bms": {
                "type": "boolean"
              },
              "c_rating": {
                "type": "number"
              }
            }
          },
          "protection": {
            "enum": [
              "fuse",
              "switch",
              "bms",
              "low-voltage-cutoff",
              "diode"
            ]
          },
          "rating_a": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
              }
            ]
          },
          "flyback": {
            "type": "boolean"
          },
          "mains": {
            "type": "boolean"
          },
          "breadboard": {
            "type": "object",
            "properties": {
              "fit": {
                "enum": [
                  "straddle",
                  "single",
                  "offboard"
                ]
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "row_spacing": {
                "type": "integer"
              },
              "body_width_mm": {
                "type": "number"
              }
            }
          },
          "geometry": {
            "type": "object"
          },
          "model": {
            "type": "string"
          },
          "library": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "verify": {
            "type": "boolean"
          },
          "inferred": {
            "type": "boolean"
          },
          "have": {
            "type": "boolean"
          },
          "bb": {
            "type": "object",
            "properties": {
              "pin1": {
                "type": "string"
              },
              "rot": {
                "type": "number"
              }
            }
          },
          "bom": {
            "type": "object"
          },
          "pins": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "power_in",
                        "power_out",
                        "power_rail",
                        "ground",
                        "digital",
                        "pwm",
                        "analog",
                        "i2c_sda",
                        "i2c_scl",
                        "uart_tx",
                        "uart_rx",
                        "spi",
                        "motor",
                        "passive",
                        "nc"
                      ]
                    },
                    "dir": {
                      "enum": [
                        "in",
                        "out",
                        "io"
                      ]
                    },
                    "voltage": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "voltage_max": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "voltage_min": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "vmin": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "vmax": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "vih": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "current": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "current_peak": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "current_max": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "pullup": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "vmax_offset": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*(\\s*[*+/-]\\s*-?[0-9.]+)?$"
                        }
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "open_drain": {
                      "type": "boolean"
                    },
                    "pullup_weak": {
                      "type": "boolean"
                    },
                    "diode": {
                      "type": "boolean"
                    },
                    "voltage_ref": {
                      "type": "string"
                    },
                    "vmax_ref": {
                      "type": "string"
                    },
                    "pullup_ref": {
                      "type": "string"
                    },
                    "pos": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "z": {
                      "type": "number"
                    },
                    "note": {
                      "type": "string"
                    },
                    "fix": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              }
            ]
          }
        }
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "pattern": "^[^.]+\\..+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[^.]+\\..+$"
          },
          "color": {
            "type": "string"
          },
          "gauge": {
            "type": "number"
          },
          "insulation": {
            "enum": [
              "pvc",
              "silicone",
              "ptfe"
            ]
          },
          "length_mm": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "bb": {
            "type": "object"
          }
        }
      }
    },
    "breadboard": {
      "type": "object",
      "properties": {
        "model": {
          "oneOf": [
            {
              "enum": [
                "half-400",
                "full-830"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "half-400",
                  "full-830"
                ]
              }
            }
          ]
        },
        "rails": {
          "type": "object"
        },
        "jumpers": {
          "type": "string"
        },
        "layout": {
          "type": "object"
        }
      }
    },
    "printer": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "volume": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "nozzle": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "send": {
          "type": "string"
        }
      }
    },
    "cad": {
      "type": "object",
      "properties": {
        "tool": {
          "enum": [
            "build123d",
            "cadquery",
            "openscad",
            "freecad",
            "fusion",
            "solidworks"
          ]
        }
      }
    },
    "assembly": {
      "type": [
        "string",
        "object"
      ]
    },
    "prints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "material": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "designed",
              "sliced",
              "printing",
              "done"
            ]
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "settings": {
            "type": "object"
          },
          "pieces": {
            "type": "array"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "explode": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "fasteners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "qty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "define",
              "parts",
              "power",
              "wire",
              "firmware",
              "print",
              "assemble",
              "test"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fasteners": {
            "type": "array"
          },
          "warning": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "bom": {
      "type": "object"
    }
  }
}
